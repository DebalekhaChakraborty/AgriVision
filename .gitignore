__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

.venv/
.venv-v2/
venv/
.env

dataset/train/
dataset/validation/
dataset/test/
model/*.h5
model/class_indices.json
outputs/*.png
static/uploads/*
!static/uploads/.gitkeep

.DS_Store

# V2 local research data and large model artifacts
v2/data/raw/*
!v2/data/raw/.gitkeep
v2/data/processed/*
!v2/data/processed/.gitkeep
v2/data/external/
v2/cache/
*.pt
*.pth
*.ckpt
*.safetensors
wandb/

# Local secret material and cloud credentials.
# Scoped deliberately narrowly so research configs (*.yaml, *.json) are unaffected.
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
.aws-sam/
aws.json
credentials
secrets.json
.venv-competition/

# Exported model graphs are build products derived from gitignored research
# checkpoints; the manifest is committed, the weights are not.
*.onnx

# Self-captured deployment-domain photographs (Phase 2c).
# Kept local even though they are self-captured: keeps the repository light and
# prevents accidental EXIF/privacy publication before sanitisation.
competition/data/self_captured/
# Manifest variant that carries filesystem paths.
competition/data/capture_manifest.local.json

# Third-party licensed imagery (Phase 2c-B).
# Bytes stay local: the licences permit redistribution, but the committed
# artifact is the provenance manifest, not other people's photographs.
# Derived degradations and generated stress images are ignored for the same
# reason plus one more - they are reproducible from the manifest and the seed.
competition/data/licensed_real/raw/
competition/data/licensed_real/cache/
competition/data/licensed_real/derived/
competition/data/licensed_real/synthetic/

# Phase 2d independent validation imagery.
competition/data/licensed_real/validation_raw/
