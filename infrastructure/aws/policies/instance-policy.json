{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyTheModelObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::agrivision-model-artifacts-341181499761/models/*"
    },
    {
      "Sid": "WriteAndReadTraceRecordsOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:DescribeTable"],
      "Resource": "arn:aws:dynamodb:us-east-1:341181499761:table/agrivision-inspection-traces"
    }
  ]
}
